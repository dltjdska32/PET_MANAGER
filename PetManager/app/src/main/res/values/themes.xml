<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 메인 테마 -->
    <style name="Base.Theme.Test1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background and surface -->
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- 기본 애니메이션 유지하되 배경색 일치로 깜빡임 방지 (windowAnimationStyle 제거) -->

        <!-- 기타 설정 -->
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/card_background</item>
    </style>

    <style name="Base.Theme.Test1.AdjustResize">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.Test1" parent="Base.Theme.Test1" />

    <!-- 바텀 네비 라벨 (색은 itemTextColor 셀렉터가 유지) -->
    <style name="TextAppearance.PetManager.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.PetManager.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 바텀 네비게이션 활성 인디케이터 (캡슐 배경) -->
    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator_fill</item>
    </style>

    <!-- 스플래시 화면용 테마 -->
    <style name="Theme.PetManager.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg_gradient</item>
        <item name="android:statusBarColor">@color/splash_gradient_start</item>
        <item name="android:navigationBarColor">@color/splash_gradient_end</item>
    </style>

    <!-- 원형 프로필 (내 정보 카드) -->
    <style name="ShapeAppearance.PetManager.AvatarCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.PetManager.ChatSendButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">@dimen/chat_send_btn_size</item>
        <item name="android:minHeight">@dimen/chat_send_btn_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="icon">@drawable/ic_send</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="rippleColor">@color/bottom_nav_ripple_pressed</item>
        <item name="android:contentDescription">메시지 전송</item>
    </style>

</resources>
